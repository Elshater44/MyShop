@using MyShop.Entities.Models
@model Category
@{
    ViewBag.PageTitle = "Category Management";
    ViewBag.CardTitle = "Delete Category";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}

@if (TempData["message"] is not null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}
<form method="post" asp-action="DeleteCategory">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Name">Name</label>
        <input disabled asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description">Description</label>
        <input disabled asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>

    </div>
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" asp-controller="Category" class="btn btn-warning">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}